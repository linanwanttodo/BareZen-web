<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!--
    Standalone bill of materials: it deliberately has no parent, because barezen-parent imports it.
    Giving it the parent as its own parent would create a resolution cycle.
  -->
  <groupId>com.barezen</groupId>
  <artifactId>barezen-bom</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>BareZen Bill Of Materials</name>
  <description>
    Version alignment for BareZen artifacts. Applications import this pom so that framework modules
    and plugins always move together.
  </description>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-core</artifactId>
        <version>${project.version}</version>
      </dependency>

      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-web</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        The first implementation of the web contract, and the only artifact in this build allowed to name
        com.sun.net.httpserver (ADR-0021). An application that imports it gets a server it can start by id; an
        application that does not still compiles, because barezen-web declares no dependency on it.
      -->
      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-http-jdk</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Security middleware on the web contract (Phase 2.11). It depends on barezen-web, never on an adapter,
        so an application wires it around a Router without taking a server dependency.
      -->
      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-security</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        The data layer (Phase 2.12). It has no framework dependency at all: it speaks javax.sql and receives an
        application-supplied DataSource, so importing it pulls in no driver and no database product (ADR-0038).
      -->
      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-data</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        The plugin ecosystem (Phase 2.13): the auth, user and OpenAPI plugins. It depends downward on core, web,
        security and data (ADR-0042's one-way direction), so importing it pulls in those capabilities and no driver
        or server beyond them.
      -->
      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-plugins</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        The test kit (Phase 2.15): a test server on the JDK adapter, the seven-verb client, fixtures and assertions.
        Applications add it in test scope; nothing in the reactor depends on it, which is the isolation ADR-0044
        states and an ArchUnit rule enforces.
      -->
      <dependency>
        <groupId>com.barezen</groupId>
        <artifactId>barezen-testkit</artifactId>
        <version>${project.version}</version>
      </dependency>

      <!--
        Future modules are listed here as they are created (testkit, app). They are intentionally absent
        for now so that the bom never advertises an artifact that does not exist.
      -->
    </dependencies>
  </dependencyManagement>
</project>
