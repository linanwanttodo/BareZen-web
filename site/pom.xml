<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>com.barezen</groupId>
    <artifactId>barezen-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>barezen-site</artifactId>
  <packaging>jar</packaging>

  <name>BareZen Website</name>
  <description>
    The framework's own site, served by the framework: hand-written HTML and one stylesheet, routed through a Router,
    served from disk through barezen-content, with /openapi.json generated by the OpenAPI plugin and /health answered by
    a plain Handler. A leaf module wired after the examples, depended on by nothing, and compiled against public API
    only — which is what makes it the first real consumer of the plugin extension points rather than a fixture that
    could quietly reach around them (ADR-0052).
  </description>

  <!--
    Five framework dependencies, every one of them a public API an application would name itself: the contract, the JDK
    server, static content, the OpenAPI plugin and — at test scope — TestKit. There is no template engine, no bundler,
    no markdown converter and no front-end framework here, because there is no build step: an asset added to
    src/main/web is served by the enumeration in Site.router(), and an asset added without being listed under
    web/ fails the test that checks the two sets agree.
  -->
  <dependencies>
    <dependency>
      <groupId>com.barezen</groupId>
      <artifactId>barezen-web</artifactId>
    </dependency>

    <dependency>
      <groupId>com.barezen</groupId>
      <artifactId>barezen-http-jdk</artifactId>
    </dependency>

    <dependency>
      <groupId>com.barezen</groupId>
      <artifactId>barezen-content</artifactId>
    </dependency>

    <dependency>
      <groupId>com.barezen</groupId>
      <artifactId>barezen-plugins</artifactId>
    </dependency>

    <dependency>
      <groupId>com.barezen</groupId>
      <artifactId>barezen-testkit</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>

    <dependency>
      <groupId>org.assertj</groupId>
      <artifactId>assertj-core</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jar-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
